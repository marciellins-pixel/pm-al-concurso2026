<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EstudaPMAL - Cebraspe | Plano de Estudos Inteligente</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: { 50: '#eff6ff', 100: '#dbeafe', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8', 900: '#1e3a8a' }
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome para ícones -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .dark .custom-scrollbar::-webkit-scrollbar-thumb { background: #475569; }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col font-sans transition-colors duration-200">

    <!-- Topbar / Header -->
    <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 sticky top-0 z-30 px-4 py-3 flex items-center justify-between shadow-sm">
        <div class="flex items-center space-x-3">
            <div class="bg-brand-600 text-white p-2 rounded-xl shadow-md flex items-center justify-center">
                <i class="fa-solid fa-shield-halved text-xl"></i>
            </div>
            <div>
                <h1 class="font-bold text-base md:text-lg tracking-tight">PM AL • Cebraspe</h1>
                <p class="text-xs text-slate-500 dark:text-slate-400">Plano de Estudos Inteligente</p>
            </div>
        </div>
        <div class="flex items-center space-x-2">
            <button onclick="openApiKeyModal()" class="flex items-center space-x-1 px-3 py-1.5 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 rounded-lg text-xs font-medium transition" title="Configurar Chave API Gemini">
                <i class="fa-solid fa-key text-amber-500"></i>
                <span class="hidden sm:inline">API Key</span>
            </button>
            <button onclick="toggleDarkMode()" class="p-2 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 transition" title="Alternar Tema">
                <i id="themeIcon" class="fa-solid fa-moon text-sm"></i>
            </button>
        </div>
    </header>

    <!-- Main Layout Content -->
    <div class="flex-1 flex flex-col md:flex-row pb-16 md:pb-0">
        
        <!-- Sidebar Navigation (Desktop) -->
        <aside class="hidden md:flex flex-col w-64 bg-white dark:bg-slate-800 border-r border-slate-200 dark:border-slate-700 p-4 space-y-2">
            <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn flex items-center space-x-3 w-full px-4 py-2.5 rounded-xl text-sm font-medium transition bg-brand-600 text-white shadow-sm">
                <i class="fa-solid fa-chart-pie w-5"></i>
                <span>Dashboard</span>
            </button>
            <button onclick="switchTab('edital')" id="nav-edital" class="nav-btn flex items-center space-x-3 w-full px-4 py-2.5 rounded-xl text-sm font-medium transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                <i class="fa-solid fa-list-check w-5"></i>
                <span>Edital Verticalizado</span>
            </button>
            <button onclick="switchTab('pomodoro')" id="nav-pomodoro" class="nav-btn flex items-center space-x-3 w-full px-4 py-2.5 rounded-xl text-sm font-medium transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                <i class="fa-solid fa-stopwatch w-5"></i>
                <span>Pomodoro de Foco</span>
            </button>
            <button onclick="switchTab('ai')" id="nav-ai" class="nav-btn flex items-center space-x-3 w-full px-4 py-2.5 rounded-xl text-sm font-medium transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700">
                <i class="fa-solid fa-robot w-5 text-purple-400"></i>
                <span>Tutor IA Cebraspe</span>
            </button>
        </aside>

        <!-- Main Content Panel -->
        <main class="flex-1 p-4 md:p-8 max-w-6xl mx-auto w-full custom-scrollbar overflow-y-auto">

            <!-- TAB 1: DASHBOARD -->
            <section id="tab-dashboard" class="space-y-6">
                <!-- Welcome Banner -->
                <div class="bg-gradient-to-r from-blue-600 to-indigo-700 rounded-2xl p-6 text-white shadow-lg">
                    <h2 class="text-xl md:text-2xl font-bold mb-2">Foco na Aprovação PM AL 🎯</h2>
                    <p class="text-blue-100 text-sm max-w-2xl">Sistema configurado com as diretrizes da banca **Cebraspe** (Certo/Errado). Acompanhe suas metas diárias, estude os tópicos e tire dúvidas com o Tutor de Inteligência Artificial.</p>
                </div>

                <!-- Stats Grid -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-2">
                            <span class="text-xs font-semibold uppercase">Horas Estudadas</span>
                            <i class="fa-solid fa-clock text-brand-600"></i>
                        </div>
                        <div class="text-2xl font-bold" id="stat-hours">0h 00m</div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-2">
                            <span class="text-xs font-semibold uppercase">Tópicos Concluídos</span>
                            <i class="fa-solid fa-circle-check text-emerald-500"></i>
                        </div>
                        <div class="text-2xl font-bold"><span id="stat-completed">0</span>/<span id="stat-total">0</span></div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-2">
                            <span class="text-xs font-semibold uppercase">Progresso Geral</span>
                            <i class="fa-solid fa-chart-line text-amber-500"></i>
                        </div>
                        <div class="text-2xl font-bold" id="stat-percent">0%</div>
                    </div>
                    <div class="bg-white dark:bg-slate-800 p-4 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
                        <div class="flex items-center justify-between text-slate-500 dark:text-slate-400 mb-2">
                            <span class="text-xs font-semibold uppercase">Banca Alvo</span>
                            <i class="fa-solid fa-bullseye text-red-500"></i>
                        </div>
                        <div class="text-xl font-bold truncate">Cebraspe</div>
                    </div>
                </div>

                <!-- Quick Tips Card -->
                <div class="bg-white dark:bg-slate-800 rounded-2xl p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-4">
                    <h3 class="font-bold text-base flex items-center space-x-2">
                        <i class="fa-solid fa-lightbulb text-amber-500"></i>
                        <span>Dicas Estratégicas Cebraspe para PM AL</span>
                    </h3>
                    <ul class="grid md:grid-cols-2 gap-3 text-sm text-slate-600 dark:text-slate-300">
                        <li class="bg-slate-50 dark:bg-slate-700/50 p-3 rounded-xl border border-slate-100 dark:border-slate-700">
                            <strong>Método Certo/Errado:</strong> Em provas Cebraspe, uma errada anula uma certa. Treine marcar apenas quando tiver segurança.
                        </li>
                        <li class="bg-slate-50 dark:bg-slate-700/50 p-3 rounded-xl border border-slate-100 dark:border-slate-700">
                            <strong>Legislação PM AL:</strong> O Estatuto e regulamentos próprios respondem por grande parte dos pontos específicos.
                        </li>
                    </ul>
                </div>
            </section>

            <!-- TAB 2: EDITAL VERTICALIZADO -->
            <section id="tab-edital" class="space-y-6 hidden">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                    <div>
                        <h2 class="text-xl font-bold">Edital Verticalizado PM AL</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Marque os tópicos conforme avança nos estudos.</p>
                    </div>
                    <div class="flex space-x-2">
                        <button onclick="resetEdital()" class="px-3 py-2 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 rounded-xl text-xs font-semibold transition">Restaurar Padrão</button>
                    </div>
                </div>

                <!-- Container das Matérias -->
                <div id="edital-container" class="space-y-4">
                    <!-- Gerado Dinamicamente via JS -->
                </div>
            </section>

            <!-- TAB 3: POMODORO -->
            <section id="tab-pomodoro" class="space-y-6 hidden">
                <div class="max-w-md mx-auto bg-white dark:bg-slate-800 rounded-3xl p-6 md:p-8 border border-slate-200 dark:border-slate-700 shadow-xl text-center space-y-6">
                    <h2 class="text-xl font-bold">Cronômetro de Foco</h2>
                    
                    <div class="flex justify-center space-x-2">
                        <button onclick="setPomodoroMode('focus')" id="mode-focus" class="px-4 py-1.5 rounded-full text-xs font-semibold bg-brand-600 text-white transition">Foco (25m)</button>
                        <button onclick="setPomodoroMode('shortBreak')" id="mode-shortBreak" class="px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 transition">Pausa Curta (5m)</button>
                        <button onclick="setPomodoroMode('longBreak')" id="mode-longBreak" class="px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 transition">Pausa Longa (15m)</button>
                    </div>

                    <div class="text-6xl md:text-7xl font-black tracking-wider text-brand-600 dark:text-brand-500 my-4 font-mono" id="pomodoro-timer">
                        25:00
                    </div>

                    <div class="flex justify-center space-x-4">
                        <button onclick="startPomodoro()" id="btn-start" class="px-6 py-3 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded-2xl shadow-lg transition flex items-center space-x-2">
                            <i class="fa-solid fa-play"></i><span>Iniciar</span>
                        </button>
                        <button onclick="pausePomodoro()" id="btn-pause" class="px-6 py-3 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded-2xl shadow-lg transition hidden items-center space-x-2">
                            <i class="fa-solid fa-pause"></i><span>Pausar</span>
                        </button>
                        <button onclick="resetPomodoro()" class="px-4 py-3 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 font-bold rounded-2xl transition">
                            <i class="fa-solid fa-rotate-right"></i>
                        </button>
                    </div>
                </div>
            </section>

            <!-- TAB 4: TUTOR IA (GEMINI API) -->
            <section id="tab-ai" class="space-y-4 h-[calc(100vh-140px)] md:h-[calc(100vh-100px)] flex flex-col hidden">
                <div class="flex items-center justify-between">
                    <div>
                        <h2 class="text-xl font-bold flex items-center space-x-2">
                            <i class="fa-solid fa-robot text-purple-500"></i>
                            <span>Tutor IA • Cebraspe PM AL</span>
                        </h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Pergunte sobre leis, resolva questões Certo/Errado ou peça resumos.</p>
                    </div>
                </div>

                <!-- Chat Box Messages -->
                <div id="chat-messages" class="flex-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-4 overflow-y-auto space-y-4 shadow-sm custom-scrollbar">
                    <div class="flex items-start space-x-3">
                        <div class="bg-purple-600 text-white p-2 rounded-xl text-xs font-bold">IA</div>
                        <div class="bg-slate-100 dark:bg-slate-700/60 p-3.5 rounded-2xl text-sm max-w-[85%] leading-relaxed">
                            Olá! Sou seu tutor especialista no concurso da <strong>PM AL (Banca Cebraspe)</strong>. Como posso te ajudar hoje? Posso criar simulados no formato Certo/Errado, explicar artigos de leis ou montar esquemas de estudo.
                        </div>
                    </div>
                </div>

                <!-- Suggested Quick Prompts -->
                <div class="flex space-x-2 overflow-x-auto pb-1 text-xs">
                    <button onclick="sendQuickPrompt('Elabore 3 questões estilo Cebraspe (Certo ou Errado) sobre Direito Penal Militar com gabarito justificado.')" class="whitespace-nowrap px-3 py-1.5 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-brand-50 rounded-lg transition">📝 Simulado Cebraspe (C/E)</button>
                    <button onclick="sendQuickPrompt('Quais são os principais pontos cobrados em Legislação da PM AL pela banca Cebraspe?')" class="whitespace-nowrap px-3 py-1.5 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-brand-50 rounded-lg transition">⚖️ Estatuto PM AL Dicas</button>
                    <button onclick="sendQuickPrompt('Resuma as regras de Concordância Verbal e Crase com foco em questões de Língua Portuguesa do Cebraspe.')" class="whitespace-nowrap px-3 py-1.5 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 hover:bg-brand-50 rounded-lg transition">📖 Português Cebraspe</button>
                </div>

                <!-- Chat Input Form -->
                <form id="chat-form" onsubmit="handleChatSubmit(event)" class="flex space-x-2">
                    <input type="text" id="chat-input" placeholder="Digite sua dúvida sobre o edital PM AL..." class="flex-1 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-600 shadow-sm">
                    <button type="submit" class="bg-brand-600 hover:bg-brand-700 text-white px-5 py-3 rounded-xl font-medium transition shadow-md">
                        <i class="fa-solid fa-paper-plane"></i>
                    </button>
                </form>
            </section>

        </main>
    </div>

    <!-- Bottom Navigation Bar (Mobile Only) -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 bg-white dark:bg-slate-800 border-t border-slate-200 dark:border-slate-700 flex justify-around p-2 z-30 shadow-lg">
        <button onclick="switchTab('dashboard')" id="mob-dashboard" class="mob-btn flex flex-col items-center text-brand-600 dark:text-brand-400 p-1">
            <i class="fa-solid fa-chart-pie text-lg"></i>
            <span class="text-[10px] mt-0.5">Resumo</span>
        </button>
        <button onclick="switchTab('edital')" id="mob-edital" class="mob-btn flex flex-col items-center text-slate-400 p-1">
            <i class="fa-solid fa-list-check text-lg"></i>
            <span class="text-[10px] mt-0.5">Edital</span>
        </button>
        <button onclick="switchTab('pomodoro')" id="mob-pomodoro" class="mob-btn flex flex-col items-center text-slate-400 p-1">
            <i class="fa-solid fa-stopwatch text-lg"></i>
            <span class="text-[10px] mt-0.5">Foco</span>
        </button>
        <button onclick="switchTab('ai')" id="mob-ai" class="mob-btn flex flex-col items-center text-slate-400 p-1">
            <i class="fa-solid fa-robot text-lg text-purple-400"></i>
            <span class="text-[10px] mt-0.5">Tutor IA</span>
        </button>
    </nav>

    <!-- Modal API Key -->
    <div id="apiKeyModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white dark:bg-slate-800 rounded-3xl p-6 max-w-md w-full border border-slate-200 dark:border-slate-700 shadow-2xl space-y-4">
            <h3 class="font-bold text-lg">Configurar Chave API Gemini</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400">Insira sua chave API do Google Gemini para ativar o Tutor de Inteligência Artificial no chat.</p>
            <input type="password" id="apiKeyInput" placeholder="Cole sua chave aqui (AIzaSy...)" class="w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-sm focus:outline-none focus:border-brand-600">
            <div class="flex justify-end space-x-2">
                <button onclick="closeApiKeyModal()" class="px-4 py-2 bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 text-xs font-semibold rounded-xl transition">Cancelar</button>
                <button onclick="saveApiKey()" class="px-4 py-2 bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold rounded-xl transition">Salvar Chave</button>
            </div>
        </div>
    </div>

    <!-- Script de Funcionalidades -->
    <script>
        // Dados Padrão do Edital PM AL (Cebraspe)
        const defaultEdital = [
            {
                categoria: "Conhecimentos Básicos",
                topicos: [
                    { id: "b1_1", nome: "Língua Portuguesa: Compreensão e interpretação de textos", concluido: false },
                    { id: "b1_2", nome: "Língua Portuguesa: Reescrita de frases e substituição de palavras", concluido: false },
                    { id: "b1_3", nome: "Língua Portuguesa: Sintaxe, crase, pontuação, concordância e regência", concluido: false },
                    { id: "b2_1", nome: "Matemática: Conjuntos numéricos, proporções e regra de três", concluido: false },
                    { id: "b2_2", nome: "Matemática: Porcentagem, juros simples e compostos", concluido: false },
                    { id: "b3_1", nome: "Noções de Informática: Segurança da informação e redes", concluido: false },
                    { id: "b3_2", nome: "Noções de Informática: Windows, Pacote Office e nuvem", concluido: false },
                    { id: "b4_1", nome: "História e Geografia de Alagoas: Quilombo dos Palmares e economia açucareira", concluido: false },
                    { id: "b4_2", nome: "História e Geografia de Alagoas: Aspectos físicos e demográficos do Estado", concluido: false }
                ]
            },
            {
                categoria: "Conhecimentos Específicos",
                topicos: [
                    { id: "e1_1", nome: "Legislação PM AL: Estatuto dos Policiais Militares de Alagoas", concluido: false },
                    { id: "e1_2", nome: "Legislação PM AL: Regulamentos e normas internas da corporação", concluido: false },
                    { id: "e2_1", nome: "Direito Constitucional: Direitos e Garantias Fundamentais", concluido: false },
                    { id: "e2_2", nome: "Direito Constitucional: Artigo 144 (Segurança Pública) e Organização do Estado", concluido: false },
                    { id: "e3_1", nome: "Direito Administrativo: Atos administrativos e Poderes da administração", concluido: false },
                    { id: "e3_2", nome: "Direito Administrativo: Agentes públicos e Lei de Improbidade Administrativa", concluido: false },
                    { id: "e4_1", nome: "Direito Penal e Processual Penal: Crimes contra a pessoa e o patrimônio", concluido: false },
                    { id: "e4_2", nome: "Direito Penal e Processual Penal: Inquérito policial e Prisão em flagrante", concluido: false },
                    { id: "e5_1", nome: "Direito Penal Militar e Processual Penal Militar: Crimes militares em tempo de paz", concluido: false },
                    { id: "e5_2", nome: "Direito Penal Militar: Inquérito Policial Militar (IPM)", concluido: false },
                    { id: "e6_1", nome: "Direitos Humanos: Declaração Universal e Direitos Humanos na Constituição", concluido: false }
                ]
            }
        ];

        let state = {
            edital: JSON.parse(localStorage.getItem('pmal_edital')) || defaultEdital,
            studiedSeconds: parseInt(localStorage.getItem('pmal_seconds')) || 0,
            apiKey: localStorage.getItem('gemini_api_key') || ''
        };

        // Salvar Estado
        function saveState() {
            localStorage.setItem('pmal_edital', JSON.stringify(state.edital));
            localStorage.setItem('pmal_seconds', state.studiedSeconds);
            updateDashboard();
        }

        // Navegação de Abas
        function switchTab(tabId) {
            ['dashboard', 'edital', 'pomodoro', 'ai'].forEach(t => {
                document.getElementById(`tab-${t}`).classList.add('hidden');
                const navBtn = document.getElementById(`nav-${t}`);
                if(navBtn) {
                    navBtn.className = "nav-btn flex items-center space-x-3 w-full px-4 py-2.5 rounded-xl text-sm font-medium transition text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700";
                }
                const mobBtn = document.getElementById(`mob-${t}`);
                if(mobBtn) {
                    mobBtn.className = "mob-btn flex flex-col items-center text-slate-400 p-1";
                }
            });

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeNav = document.getElementById(`nav-${tabId}`);
            if(activeNav) activeNav.className = "nav-btn flex items-center space-x-3 w-full px-4 py-2.5 rounded-xl text-sm font-medium transition bg-brand-600 text-white shadow-sm";
            const activeMob = document.getElementById(`mob-${tabId}`);
            if(activeMob) activeMob.className = "mob-btn flex flex-col items-center text-brand-600 dark:text-brand-400 p-1";
        }

        // Renderizar Edital
        function renderEdital() {
            const container = document.getElementById('edital-container');
            container.innerHTML = '';
            
            state.edital.forEach((bloco, bIndex) => {
                let blocoDiv = document.createElement('div');
                blocoDiv.className = "bg-white dark:bg-slate-800 rounded-2xl p-4 md:p-6 border border-slate-200 dark:border-slate-700 shadow-sm space-y-3";
                
                let html = `<h3 class="font-bold text-base text-brand-600 dark:text-brand-400 border-b border-slate-100 dark:border-slate-700 pb-2">${bloco.categoria}</h3><div class="space-y-2">`;
                
                bloco.topicos.forEach((topico, tIndex) => {
                    html += `
                        <label class="flex items-center space-x-3 p-2 rounded-xl hover:bg-slate-50 dark:hover:bg-slate-700/50 cursor-pointer transition">
                            <input type="checkbox" ${topico.concluido ? 'checked' : ''} onchange="toggleTopico(${bIndex}, ${tIndex})" class="w-4 h-4 text-brand-600 rounded focus:ring-brand-500">
                            <span class="text-sm ${topico.concluido ? 'line-through text-slate-400 dark:text-slate-500' : ''}">${topico.nome}</span>
                        </label>
                    `;
                });
                html += `</div>`;
                blocoDiv.innerHTML = html;
                container.appendChild(blocoDiv);
            });
            updateDashboard();
        }

        function toggleTopico(bIndex, tIndex) {
            state.edital[bIndex].topicos[tIndex].concluido = !state.edital[bIndex].topicos[tIndex].concluido;
            saveState();
            renderEdital();
        }

        function resetEdital() {
            if(confirm("Deseja restaurar o edital padrão?")) {
                state.edital = JSON.parse(JSON.stringify(defaultEdital));
                saveState();
                renderEdital();
            }
        }

        // Atualizar Dashboard
        function updateDashboard() {
            let total = 0;
            let completed = 0;
            state.edital.forEach(b => {
                b.topicos.forEach(t => {
                    total++;
                    if(t.concluido) completed++;
                });
            });

            document.getElementById('stat-total').innerText = total;
            document.getElementById('stat-completed').innerText = completed;
            let percent = total > 0 ? Math.round((completed / total) * 100) : 0;
            document.getElementById('stat-percent').innerText = percent + '%';

            let hours = Math.floor(state.studiedSeconds / 3600);
            let mins = Math.floor((state.studiedSeconds % 3600) / 60);
            document.getElementById('stat-hours').innerText = `${hours}h ${mins < 10 ? '0' : ''}${mins}m`;
        }

        // Pomodoro Lógica
        let pomodoroInterval = null;
        let pomodoroSeconds = 25 * 60;
        let currentPomodoroMode = 'focus';
        let isRunning = false;

        function setPomodoroMode(mode) {
            currentPomodoroMode = mode;
            pausePomodoro();
            if(mode === 'focus') pomodoroSeconds = 25 * 60;
            if(mode === 'shortBreak') pomodoroSeconds = 5 * 60;
            if(mode === 'longBreak') pomodoroSeconds = 15 * 60;
            
            ['focus', 'shortBreak', 'longBreak'].forEach(m => {
                const btn = document.getElementById(`mode-${m}`);
                btn.className = m === mode ? "px-4 py-1.5 rounded-full text-xs font-semibold bg-brand-600 text-white transition" : "px-4 py-1.5 rounded-full text-xs font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300 transition";
            });
            updatePomodoroDisplay();
        }

        function updatePomodoroDisplay() {
            let m = Math.floor(pomodoroSeconds / 60);
            let s = pomodoroSeconds % 60;
            document.getElementById('pomodoro-timer').innerText = `${m < 10 ? '0' : ''}${m}:${s < 10 ? '0' : ''}${s}`;
        }

        function startPomodoro() {
            if(isRunning) return;
            isRunning = true;
            document.getElementById('btn-start').classList.add('hidden');
            document.getElementById('btn-pause').classList.remove('hidden');

            pomodoroInterval = setInterval(() => {
                if(pomodoroSeconds > 0) {
                    pomodoroSeconds--;
                    if(currentPomodoroMode === 'focus') {
                        state.studiedSeconds++;
                        saveState();
                    }
                    updatePomodoroDisplay();
                } else {
                    pausePomodoro();
                    alert("Tempo concluído! Excelente foco.");
                }
            }, 1000);
        }

        function pausePomodoro() {
            isRunning = false;
            clearInterval(pomodoroInterval);
            document.getElementById('btn-start').classList.remove('hidden');
            document.getElementById('btn-pause').classList.add('hidden');
        }

        function resetPomodoro() {
            pausePomodoro();
            setPomodoroMode(currentPomodoroMode);
        }

        // Chat com Gemini API (Tutor Cebraspe)
        function openApiKeyModal() {
            document.getElementById('apiKeyInput').value = state.apiKey;
            document.getElementById('apiKeyModal').classList.remove('hidden');
        }

        function closeApiKeyModal() {
            document.getElementById('apiKeyModal').classList.add('hidden');
        }

        function saveApiKey() {
            state.apiKey = document.getElementById('apiKeyInput').value.trim();
            localStorage.setItem('gemini_api_key', state.apiKey);
            closeApiKeyModal();
            alert("Chave API salva com sucesso!");
        }

        function sendQuickPrompt(promptText) {
            document.getElementById('chat-input').value = promptText;
            handleChatSubmit(new Event('submit'));
        }

        async function handleChatSubmit(event) {
            event.preventDefault();
            const inputEl = document.getElementById('chat-input');
            const text = inputEl.value.trim();
            if(!text) return;

            if(!state.apiKey) {
                alert("Por favor, configure sua chave API do Gemini no botão superior direito antes de usar o Tutor IA.");
                openApiKeyModal();
                return;
            }

            appendMessage(text, 'user');
            inputEl.value = '';

            const loadingId = appendMessage("Analisando com base no edital Cebraspe PM AL...", 'ai', true);

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${state.apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [
                            {
                                role: "user",
                                parts: [
                                    { text: "Você é um tutor especialista no concurso da Polícia Militar de Alagoas (PM AL) organizado pela banca Cebraspe. Suas respostas devem focar nas disciplinas de Conhecimentos Básicos e Específicos do edital PM AL, fornecendo explicações claras, simulados em Certo/Errado quando solicitado e resumos práticos." },
                                    { text: text }
                                ]
                            }
                        ]
                    })
                });

                const data = await response.json();
                document.getElementById(loadingId).remove();

                if(data.candidates && data.candidates[0].content.parts[0].text) {
                    appendMessage(data.candidates[0].content.parts[0].text, 'ai');
                } else {
                    appendMessage("Desculpe, ocorreu um erro ao processar sua resposta com a API.", 'ai');
                }
            } catch (err) {
                document.getElementById(loadingId).remove();
                appendMessage("Erro de conexão ao acessar a API do Gemini.", 'ai');
            }
        }

        function appendMessage(text, sender, isLoading = false) {
            const chatMessages = document.getElementById('chat-messages');
            const msgDiv = document.createElement('div');
            const msgId = 'msg_' + Math.random().toString(36.subString(2, 9));
            msgDiv.id = msgId;
            msgDiv.className = `flex items-start space-x-3 ${sender === 'user' ? 'justify-end' : ''}`;

            if(sender === 'user') {
                msgDiv.innerHTML = `
                    <div class="bg-brand-600 text-white p-3.5 rounded-2xl text-sm max-w-[85%] leading-relaxed shadow-sm">${escapeHtml(text)}</div>
                    <div class="bg-slate-700 text-white p-2 rounded-xl text-xs font-bold">Você</div>
                `;
            } else {
                msgDiv.innerHTML = `
                    <div class="bg-purple-600 text-white p-2 rounded-xl text-xs font-bold">IA</div>
                    <div class="bg-slate-100 dark:bg-slate-700/60 p-3.5 rounded-2xl text-sm max-w-[85%] leading-relaxed ${isLoading ? 'animate-pulse' : ''}">${escapeHtml(text)}</div>
                `;
            }

            chatMessages.appendChild(msgDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
            return msgId;
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        // Dark Mode Toggle
        function toggleDarkMode() {
            const html = document.documentElement;
            html.classList.toggle('dark');
            const icon = document.getElementById('themeIcon');
            if(html.classList.contains('dark')) {
                icon.className = "fa-solid fa-moon text-sm";
            } else {
                icon.className = "fa-solid fa-sun text-sm text-amber-500";
            }
        }

        // Inicialização
        window.onload = function() {
            renderEdital();
            updateDashboard();
        };
    </script>
</body>
</html>
